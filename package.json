{
  "name": "novadiff",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "rust:build": "cargo build --release --manifest-path cli/Cargo.toml",
    "electron:dev": "npm run rust:build && concurrently -k \"npm run dev\" \"wait-on http://127.0.0.1:1420 && node ./scripts/run-electron.cjs\"",
    "build": "tsc && vite build",
    "electron:build": "npm run rust:build && npm run build && electron-builder",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "lucide-react": "^0.511.0",
    "marked": "^15.0.7",
    "mermaid": "^11.15.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-window": "^1.8.11",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/react-window": "^1.8.8",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.novadiff.desktop",
    "productName": "NovaDiff",
    "icon": "nova-diff-icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "nova-diff-icon.png",
      "node_modules/marked/**/*"
    ],
    "extraResources": [
      {
        "from": "cli/target/release",
        "filter": [
          "novadiff-cli",
          "novadiff-cli.exe"
        ],
        "to": "."
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
